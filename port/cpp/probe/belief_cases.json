    {
      "id": "extremes",
      "why": "Enough evidence one way that a one-line sigmoid loses the answer. NOT an arbitrary large number: at 245 steps the log-odds sit at -721, where exp(721) overflows to inf and `1/(1+exp(-x))` returns a flat 0 while the two-branch form still returns 5.07e-314. Below about 243 steps both are right, and above about 253 both are 0 -- the first version of this case used 400 and passed a deliberately broken sigmoid.",
      "updates": [
        {"repeat": 245, "predicate": "body:alive", "slots": {"agent": "agent:cold"},
         "polarity": "-", "trust": 1.0, "competence": 1.0, "skepticism": 0.0,
         "claim_id": "claim:x", "origin": "vary", "world_time": 5, "speaker": "agent:w"}
      ]
    },
    {
      "id": "missing_and_null_slots",
